AUTH_SECRET=depthboard-demo-auth-secret-change-me

# Optional public app origin (Checkout success/cancel URLs). Falls back to request Host.
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe Checkout (test mode) — leave unset for simulated cart pay.
# Never commit real secrets. Use sk_test_ / pk_test_ / whsec_ values from Stripe Dashboard.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional OpenAI polish for AI coach summaries (PWF-21).
# Leave unset to use deterministic heuristics + template summary.
# OPENAI_API_KEY=
# OPENAI_COACH_MODEL=gpt-4o-mini
